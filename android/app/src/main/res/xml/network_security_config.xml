<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Venue-specific hub CAs are installed by an administrator. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
