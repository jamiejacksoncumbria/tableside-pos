rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The server-issued custom claim is the normal authentication route. The
    // platformAdmins record is a server-only, trusted fallback for native
    // clients while Firebase Auth refreshes a newly granted claim.
    function isPlatformAdmin() {
      return signedIn() && (
        request.auth.token.platformAdmin == true
        || exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
      );
    }

    function membership(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    function isMember(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && membership(tenantId).data.get('active', true) != false;
    }

    function managesTenant(tenantId) {
      return isMember(tenantId) && membership(tenantId).data.roles.hasAny(['owner', 'manager']);
    }

    // Venue records are server-managed. A venue marked as `deleting` rejects
    // new client writes while the trusted delete function checks whether any
    // operational or historical documents still reference it.
    function isActiveVenue(tenantId, venueId) {
      return venueId is string
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/venues/$(venueId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/venues/$(venueId))
          .data.get('status', 'active') == 'active';
    }

    function tenantCurrencyCode(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId))
        .data.get('currencyCode', 'GBP');
    }

    function changesOnlyTenantProfile() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'legalName',
        'logoUrl',
        'address',
        'phone',
        'phoneNumbers',
        'receiptFooter'
      ]);
    }

    function isAssignedPrintDevice(tenantId) {
      let devicePath = /databases/$(database)/documents/tenants/$(tenantId)/devices/$(resource.data.targetDeviceId);
      return signedIn()
        && exists(devicePath)
        && get(devicePath).data.active == true
        && get(devicePath).data.assignedUserId == request.auth.uid;
    }

    // The worker may only claim the job that targets its registered physical
    // device. Later updates must come from that original claim; a user who is
    // assigned to several devices cannot move a job between them.
    function validPrintJobStateTransition() {
      return (resource.data.status == 'queued'
          && request.resource.data.status == 'claimed'
          && request.resource.data.claimedByDeviceId == resource.data.targetDeviceId)
        || (resource.data.status == 'claimed'
          && resource.data.claimedByDeviceId == resource.data.targetDeviceId
          && request.resource.data.status in ['queued', 'printed', 'failed']);
    }

    match /tenants/{tenantId} {
      // Tenant provisioning and membership assignment are server-only. This
      // prevents a signed-in client from creating a tenant or granting itself
      // an owner role.
      allow create: if false;
      allow get: if isPlatformAdmin() || isMember(tenantId);
      // Currency is selected only when the restaurant is created and remains
      // permanent. Client profile edits may never bypass that historical-money
      // safeguard.
      allow update: if (isPlatformAdmin() || managesTenant(tenantId))
        && changesOnlyTenantProfile();
      allow delete: if false;

      match /members/{userId} {
        // `resource.data.userId` makes the collection-group membership query
        // provably safe: a signed-in user can stream only their own
        // membership records. Managers can still inspect their tenant's
        // members, while membership changes remain server-only.
        allow read: if isPlatformAdmin()
          || (signedIn() && resource.data.userId == request.auth.uid)
          || managesTenant(tenantId);
        allow write: if false;
      }

      match /venues/{venueId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        // Creation, editing, and deletion use trusted server functions so
        // time zones, unique venue names, and deletion safeguards cannot be
        // bypassed by a client.
        allow write: if false;
      }

      match /menuSections/{sectionId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        allow write: if isPlatformAdmin() || managesTenant(tenantId);
      }

      match /products/{productId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        allow write: if isPlatformAdmin() || managesTenant(tenantId);
      }

      // Stock movements are immutable and server-created alongside a verified
      // release-to-production command. A client must never decrement stock by
      // writing a movement or product value directly.
      match /stockMovements/{movementId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        allow write: if false;
      }

      match /tables/{tableId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        allow write: if false;
      }

      // Server-only table-label registry makes table names unique per venue.
      match /tableLabels/{labelId} {
        allow read, write: if false;
      }

      // Open named tabs are server-managed, venue-local unique-name records.
      match /openTabNames/{tabId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        allow write: if false;
      }

      match /orders/{orderId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        allow write: if false;
      }

      // Production tickets contain kitchen/bar-safe order summaries only. New
      // tickets and state changes come from trusted, auditable commands.
      match /productionTickets/{ticketId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        allow write: if false;
      }

      match /bills/{billId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        // Payment, tax, stock, and close-of-day writes must be made by a
        // trusted Cloud Function using the Admin SDK, not by a client.
        allow write: if false;
      }

      match /paymentRequests/{requestId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        // A server function validates the bill amount, creates the provider
        // payment intent, and is the only actor allowed to change its status.
        allow create: if (isPlatformAdmin() || isMember(tenantId))
          && request.resource.data.keys().hasAll([
            'venueId', 'billId', 'amountMinor', 'currencyCode', 'method', 'status', 'idempotencyKey', 'requestedAt'
          ])
          && request.resource.data.currencyCode == tenantCurrencyCode(tenantId)
          && isActiveVenue(tenantId, request.resource.data.venueId);
        allow update, delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if isPlatformAdmin()
          || managesTenant(tenantId)
          || (signedIn() && resource.data.assignedUserId == request.auth.uid);
        allow create: if (isPlatformAdmin() || managesTenant(tenantId))
          && isActiveVenue(tenantId, request.resource.data.venueId);
        allow delete: if isPlatformAdmin() || managesTenant(tenantId);
        allow update: if ((isPlatformAdmin() || managesTenant(tenantId))
            && isActiveVenue(tenantId, request.resource.data.venueId))
          || ((signedIn() && resource.data.assignedUserId == request.auth.uid)
            && isActiveVenue(tenantId, resource.data.venueId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHeartbeatAt']));
      }

      // Only a manager can choose where a venue's kitchen, bar, and dessert
      // tickets go. The trusted order command verifies a configured device
      // belongs to this venue before creating the job.
      match /printerRoutes/{routeId} {
        allow read: if isPlatformAdmin() || isMember(tenantId);
        allow create, update: if (isPlatformAdmin() || managesTenant(tenantId))
          && isActiveVenue(tenantId, request.resource.data.venueId);
        allow delete: if isPlatformAdmin() || managesTenant(tenantId);
      }

      match /printJobs/{jobId} {
        allow read: if isPlatformAdmin()
          || managesTenant(tenantId)
          || isAssignedPrintDevice(tenantId);
        allow create, delete: if false;
        allow update: if isAssignedPrintDevice(tenantId)
          && validPrintJobStateTransition()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'claimedByDeviceId', 'claimedAt', 'completedAt', 'failureReason', 'attempts', 'nextAttemptAt'
          ]);
      }
    }

    match /platformAdmins/{userId} {
      // A person may read only their own server-managed access record.  It
      // lets the app recognise a platform admin even before a claim refresh.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Staff identities are server-managed and retained as historical
    // attribution when an account is retired.
    match /staffProfiles/{userId} {
      allow get: if isPlatformAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow list, create, update, delete: if false;
    }

    match /platformAdminAudit/{auditId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // The app uses collectionGroup('members') to discover the signed-in
    // person's restaurant memberships. Collection-group queries require a
    // version-2 recursive match, and the same userId condition as the query.
    match /{path=**}/members/{userId} {
      allow read: if isPlatformAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
  }
}
