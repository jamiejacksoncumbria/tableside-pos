{
  "name": "tableside-functions",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "scripts": {
    "check": "node --check index.js",
    "test:security": "node --test test/security-rules.test.js",
    "test:security:emulator": "firebase emulators:exec --config ../firebase.security-test.json --project demo-tableside-security --only firestore,database \"npm run test:security\"",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0"
  }
}
